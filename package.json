{
  "name": "prolog-notebook",
  "version": "0.6.2",
  "description": "Jupyter-style notebooks for Prolog. Runs in the browser, installs nothing.",
  "type": "module",
  "main": "./src/node.js",
  "bin": {
    "prolog-notebook": "./bin/prolog-notebook.mjs"
  },
  "exports": {
    ".": "./src/node.js",
    "./browser": "./src/browser.js",
    "./engine": "./src/engine.js",
    "./format": "./src/format.js",
    "./notebook.css": "./src/notebook.css",
    "./page": "./src/page.js",
    "./render": "./src/render.js",
    "./session": "./src/session.js",
    "./worker": "./src/worker.js",
    "./run": "./src/run.js",
    "./export": "./src/export.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "python3 -m http.server 8777",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "prolog",
    "notebook",
    "jupyter",
    "swi-prolog",
    "wasm",
    "webassembly",
    "logic-programming",
    "literate-programming"
  ],
  "author": "Johnny Jarecsni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarecsni/prolog-notebook.git"
  },
  "bugs": {
    "url": "https://github.com/jarecsni/prolog-notebook/issues"
  },
  "homepage": "https://github.com/jarecsni/prolog-notebook#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "swipl-wasm": "8.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
